# Copy to .env and fill in. NEVER commit the real .env.
# Generate keys with:  openssl rand -base64 32

DB_PASSWORD=change-me-strong

# Transactional email relay (Postmark / SES / Mailgun SMTP). Do NOT self-host SMTP.
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
APP_FROM_ADDRESS=alerts@yourdomain.com

# 32-byte base64 keys. Keep these out of the database and out of version control.
APP_CRYPTO_KEY=REPLACE_WITH_openssl_rand_base64_32
APP_EMAIL_HMAC_KEY=REPLACE_WITH_openssl_rand_base64_32
APP_JWT_SIGNING_KEY=REPLACE_WITH_openssl_rand_base64_32
